{
  "openapi": "3.1.0",
  "info": {
    "title": "Landing Contact Service",
    "description": "Backend-сервис для лендинг-презентации разработчика: форма обратной связи с валидацией, email-уведомлениями, rate limiting и AI-анализом обращений.",
    "contact": {
      "name": "Landing Contact Service",
      "email": "owner@example.com"
    },
    "license": {
      "name": "MIT"
    },
    "version": "1.1.0"
  },
  "paths": {
    "/api/config/public": {
      "get": {
        "tags": [
          "contact"
        ],
        "summary": "Публичная конфигурация для фронтенда",
        "operationId": "public_config_api_config_public_get",
        "responses": {
          "200": {
            "description": "Публичные настройки для клиента",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfigResponse"
                },
                "example": {
                  "turnstile_site_key": "0x4AAAAAAA...",
                  "turnstile_enabled": true
                }
              }
            }
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "tags": [
          "contact"
        ],
        "summary": "Отправить обращение через форму обратной связи",
        "description": "Полный цикл: валидация -> rate limit -> captcha -> save -> AI -> email queue -> ответ.",
        "operationId": "create_contact_api_contact_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Обращение принято и обработано",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "success": true,
                  "message": "Спасибо! Ваше обращение принято.",
                  "request_id": "req-abc123",
                  "received_at": "2026-07-16T12:00:00Z",
                  "analysis": {
                    "sentiment": "positive",
                    "category": "project_inquiry",
                    "auto_reply": "Спасибо за обращение!",
                    "summary": "Клиент интересуется проектом",
                    "ai_used": false
                  },
                  "email_queued": true
                }
              }
            }
          },
          "400": {
            "description": "CAPTCHA verification failed",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "captcha_failed",
                  "message": "CAPTCHA verification failed",
                  "status": 400,
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "422": {
            "description": "Ошибка валидации",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "validation_error",
                  "message": "Request validation failed",
                  "status": 422,
                  "request_id": "a1b2c3d4e5f6",
                  "detail": [
                    {
                      "field": "email",
                      "message": "value is not a valid email address",
                      "type": "value_error"
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Rate limit",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "rate_limit_exceeded",
                  "message": "Too many requests. Please try again later.",
                  "status": 429,
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency-Key reused with a different body",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "idempotency_conflict",
                  "message": "Idempotency-Key was reused with a different request body",
                  "status": 409,
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "internal_error",
                  "message": "Internal server error",
                  "status": 500,
                  "request_id": "a1b2c3d4e5f6"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Публичный статус сервиса",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/details": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Подробные health probes (требуется METRICS_TOKEN)",
        "operationId": "health_details_api_health_details_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Статистика обращений (требуется METRICS_TOKEN)",
        "operationId": "metrics_api_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContactRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Name",
            "examples": [
              "Иван Петров"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "examples": [
              "ivan@example.com"
            ]
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "minLength": 5,
            "title": "Phone",
            "examples": [
              "+7 999 123-45-67"
            ]
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Comment",
            "examples": [
              "Здравствуйте! Хотел бы обсудить проект."
            ]
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website",
            "description": "Honeypot field — must be empty. Bots fill this in."
          },
          "captcha_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captcha Token",
            "description": "Cloudflare Turnstile token (required if TURNSTILE_SECRET_KEY is set)."
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "phone",
          "comment"
        ],
        "title": "ContactRequest"
      },
      "HealthCheckDetail": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "status",
          "detail"
        ],
        "title": "HealthCheckDetail"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "title": "Time"
          },
          "ai_provider": {
            "type": "string",
            "title": "Ai Provider"
          },
          "ai_configured": {
            "type": "boolean",
            "title": "Ai Configured"
          },
          "smtp_configured": {
            "type": "boolean",
            "title": "Smtp Configured"
          },
          "email_configured": {
            "type": "boolean",
            "title": "Email Configured",
            "default": false
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthCheckDetail"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "time",
          "ai_provider",
          "ai_configured",
          "smtp_configured",
          "checks"
        ],
        "title": "HealthResponse"
      },
      "MetricsResponse": {
        "properties": {
          "total_requests": {
            "type": "integer",
            "title": "Total Requests"
          },
          "emails_sent_owner": {
            "type": "integer",
            "title": "Emails Sent Owner",
            "default": 0
          },
          "emails_sent_user": {
            "type": "integer",
            "title": "Emails Sent User",
            "default": 0
          },
          "emails_queued": {
            "type": "integer",
            "title": "Emails Queued",
            "default": 0
          },
          "ai_used": {
            "type": "integer",
            "title": "Ai Used",
            "default": 0
          },
          "ai_fallback": {
            "type": "integer",
            "title": "Ai Fallback",
            "default": 0
          },
          "ai_circuit_open_count": {
            "type": "integer",
            "title": "Ai Circuit Open Count",
            "default": 0
          },
          "by_sentiment": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Sentiment"
          },
          "by_category": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Category"
          },
          "first_request_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Request At"
          },
          "last_request_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Request At"
          }
        },
        "type": "object",
        "required": [
          "total_requests"
        ],
        "title": "MetricsResponse"
      },
      "PublicConfigResponse": {
        "properties": {
          "turnstile_site_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turnstile Site Key"
          },
          "turnstile_enabled": {
            "type": "boolean",
            "title": "Turnstile Enabled"
          }
        },
        "type": "object",
        "required": [
          "turnstile_enabled"
        ],
        "title": "PublicConfigResponse"
      },
      "PublicHealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "title": "Time"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "time"
        ],
        "title": "PublicHealthResponse"
      }
    }
  },
  "tags": [
    {
      "name": "contact",
      "description": "Форма обратной связи и публичная конфигурация"
    },
    {
      "name": "system",
      "description": "Health-check, метрики и служебные эндпоинты"
    }
  ]
}
