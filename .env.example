# ── Общие настройки приложения ─────────────────────────────
APP_NAME="Landing Contact Service"
APP_ENV=development              # development | staging | production
DEBUG=false
LOG_FORMAT=text                  # text | json
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true      # auto-disabled when CORS_ORIGINS=*
# В production CORS_ORIGINS обязан быть явным whitelist фронтенда (например Netlify).

# ── Trusted proxy ─────────────────────────────────────────
# X-Forwarded-For / X-Real-IP доверяются, если прямой IP в списке,
# либо если TRUST_PROXY_HEADERS=true.
# На Railway и Render доверие включается автоматически, если не задано 0/false.
TRUSTED_PROXY_IPS=
TRUST_PROXY_HEADERS=

# ── Rate limiting — IP ────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=60

# ── Rate limiting — email ─────────────────────────────────
RATE_LIMIT_EMAIL_MAX=2
RATE_LIMIT_EMAIL_WINDOW=3600

# ── Validation ────────────────────────────────────────────
DEFAULT_PHONE_REGION=RU

# ── PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://landing:landing@localhost:5432/landing
DB_POOL_SIZE=5
DB_ECHO=false

# ── Redis (rate limit + ARQ email queue) ──────────────────
# docker compose: redis://:landing-dev@localhost:6379
REDIS_URL=

# ── Email (Resend → SMTP on failure → log) ────────────────
# Resend пробуется первым. При ошибке используется SMTP, если задан SMTP_HOST;
# иначе письмо учитывается как недоставленное (в лог без тела).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM="Landing Bot <onboarding@resend.dev>"
OWNER_EMAIL=owner@example.com

# ── AI ────────────────────────────────────────────────────
AI_PROVIDER=openai
AI_TIMEOUT_SECONDS=15
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=300

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Cloudflare Turnstile CAPTCHA ──────────────────────────
# В production TURNSTILE_SECRET_KEY обязателен.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Служебные эндпоинты ───────────────────────────────────
# Защищает GET /api/metrics и GET /api/health/details.
# В production обязателен. Передаётся как Authorization: Bearer <token>
# или заголовок X-Metrics-Token.
METRICS_TOKEN=
